{
  "private": true,
  "scripts": {
    "build": "tsc && npm run build:content",
    "build:content": "node build-content.mjs",
    "build:test": "esbuild src/content/page_text.ts --format=esm --outfile=dist/test/page_text.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.content.json",
    "test": "npm run build:test && node --test test/*.test.mjs",
    "watch": "concurrently \"tsc --watch\" \"npm:watch:content\"",
    "watch:content": "node build-content.mjs",
    "dev": "npm run build && concurrently \"npm:watch\" \"npm:ext\"",
    "ext": "web-ext run --firefox=/Applications/Firefox.app/Contents/MacOS/firefox --firefox-profile=penny-release --keep-profile-changes --source-dir=."
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/turndown": "^5.0.6",
    "concurrently": "^9.1.2",
    "esbuild": "^0.27.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "web-ext": "^8.4.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "defuddle": "^0.14.0",
    "turndown": "^7.2.2"
  }
}
